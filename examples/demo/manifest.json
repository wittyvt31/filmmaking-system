        "framing": "Wide establishing frame",
        "subjectPlacement": "Character left of center",
        "cameraMovement": "Slow pan",
        "camera": {
          "type": "pan",
          "startFrame": 0,
          "durationFrames": 150,
          "from": {
            "x": 0.42,
            "y": 0.5
          },
          "to": {
            "x": 0.58,
            "y": 0.5
          }
        },
        "instructions": ["Keep the mountain horizon visible"]
      },
      "requiredAssets": [
        {
          "assetId": "sample.background",
          "version": "1.0.0"
        },
        {
          "assetId": "sample.character",
          "version": "1.0.0"
        }
      ],
      "visualElements": [
        {
          "id": "background",
