      "composition": {
        "framing": "Medium character shot",
        "subjectPlacement": "Character centered",
        "cameraMovement": "Gentle push-in",
        "camera": {
          "type": "zoom",
          "startFrame": 0,
          "durationFrames": 150,
          "fromScale": 1,
          "toScale": 1.12
