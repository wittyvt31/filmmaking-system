            "x": 0.5,
            "y": 0.5
          },
          "scale": 1,
          "zIndex": 0,
          "animation": {
            "type": "static"
          }
        },
        {
          "id": "character",
          "asset": {
            "assetId": "sample.character",
            "version": "1.0.0"
          },
          "role": "character",
          "position": {
            "x": 0.5,
