{
  "projectId": "example.demo-15s",
  "version": "1.0.0",
  "video": {
    "resolution": {
      "width": 1920,
      "height": 1080
    },
    "frameRate": {
      "numerator": 30,
      "denominator": 1
    }
  },
  "renderPolicy": {
    "outputDimensions": {
      "width": 1920,
      "height": 1080
    },
    "frameRate": {
      "numerator": 30,
      "denominator": 1
