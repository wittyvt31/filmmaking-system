        "instructions": ["Keep the face unobstructed"]
      },
      "requiredAssets": [
        {
          "assetId": "sample.background",
          "version": "1.0.0"
        },
        {
          "assetId": "sample.character",
          "version": "1.0.0"
        }
      ],
      "visualElements": [
        {
          "id": "background",
          "asset": {
            "assetId": "sample.background",
