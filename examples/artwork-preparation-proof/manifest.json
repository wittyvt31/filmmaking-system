            }
          },
          {
            "id": "lantern",
            "artwork": {
              "assetId": "prop.kerosene-lantern-illustration",
              "version": "1.0.0"
            },
            "transform": {
              "position": { "x": -1.45, "y": -0.1, "z": -0.65 },
              "rotationDegrees": { "x": 0, "y": 0, "z": 2 },
              "scale": 0.88
            }
          }
        ],
        "camera": {
          "type": "push-in",
          "startFrame": 0,
          "durationFrames": 30,
          "fromDistance": 6.5,
          "toDistance": 6.35,
          "target": { "x": 0, "y": 0, "z": 0 }
