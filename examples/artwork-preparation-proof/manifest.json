              "assetId": "character.father-cutout",
              "version": "1.0.1"
            },
            "transform": {
              "position": { "x": -0.25, "y": 0.05, "z": -0.25 },
              "rotationDegrees": { "x": 0, "y": 0, "z": 0 },
              "scale": 1
            },
            "actions": []
          }
        ],
        "props": [
          {
            "id": "chair",
            "artwork": { "assetId": "prop.wooden-chair", "version": "1.0.0" },
            "transform": {
              "position": { "x": -0.22, "y": 0.01, "z": -0.85 },
              "rotationDegrees": { "x": 0, "y": 0, "z": 0 },
              "scale": 1.15
            }
          },
          {
            "id": "telephone",
            "artwork": {
              "assetId": "prop.rotary-telephone-illustration",
              "version": "1.0.0"
            },
            "transform": {
              "position": { "x": 1.25, "y": -0.12, "z": -1.05 },
